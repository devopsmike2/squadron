# Binaries
bin/
dist/
*.exe
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.html

# Data directories — anchored to repo root so subdirs like
# ui/src/data/ don't get silently shadowed. See #606.
/data/
*.db
*.duckdb
# SQLite sidecar files — WAL/SHM are multi-MB runtime artifacts that must
# never be committed (a stray `git add -A` otherwise sweeps them in).
*.db-wal
*.db-shm
*.db.wal
*.telemetry.db*

# Local run / live-proof scratch directories. These hold runtime DBs, exported
# audit chains, and generated TLS material — none of it belongs in git, and it
# can contain secrets (keys, tokens). Keep them local-only.
/data-*/
/data-proof/
/data-enterprise/
*.pinmark

# Secrets and credential material — belt-and-suspenders so a proof/run never
# leaks a private key or token into a commit.
secrets.key
*.key
*.srl
*.csr
!**/testdata/**/*.key
.env.bak*

# Go workspace file
go.work

# IDEs
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Node modules (for UI)
ui/node_modules/
ui/dist/
ui/.pnpm-store/
ui/coverage/

# Environment files
.env
.env.local
.env.*.local

# Logs
*.log

# Temporary files
tmp/
temp/

# Built binaries (always live in bin/ or cmd/*/<name>; never the repo root)
/all-in-one
/squadronctl
/fleetsim
/otlpsim
/webhook-echo
/squadron-action-runner

# stray go build artifacts at repo root
/squadron-proposer-bench

# Go build cache (should never be tracked)
.cache/

# MkDocs documentation site
.docs-venv/
site/
